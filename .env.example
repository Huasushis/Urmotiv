NODE_ENV=
PORT=
URMOTIV_API_PORT=
# 直接运行或使用 host 网络时设为 127.0.0.1，避免 API 端口暴露到公网。
# 默认容器桥接网络保持 0.0.0.0，供同网络 Web 代理访问。
URMOTIV_API_HOST=0.0.0.0
URMOTIV_WEB_ORIGIN=
# 仅在 URMOTIV_WEB_ORIGIN 为 localhost、127.0.0.1 或 [::1] 的 HTTP 回环测试中显式设为 true。
URMOTIV_ALLOW_LOOPBACK_INSECURE_COOKIES=false
# 仅填写实际反向代理的 IPv4/IPv6 CIDR，逗号分隔；留空时来源判断忽略全部转发头。
URMOTIV_TRUSTED_PROXY_CIDRS=
URMOTIV_HTTP_PORT=
URMOTIV_DEMO_AUTH=
URMOTIV_DEMO_SEED=
DATABASE_URL=
URMOTIV_PGLITE_PATH=
URMOTIV_DATABASE_MIGRATE=
REDIS_URL=
JOB_REDIS_PREFIX=
JOB_LEASE_MS=
JOB_RETRY_DELAY_MS=
WORKER_ID=
WORKER_POLL_INTERVAL_MS=
STORAGE_LOCAL_ROOT=
STORAGE_MAX_FILE_BYTES=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=
# 32 字节随机值的 Base64URL 编码；轻量模式未保存插件密钥时可以留空。
URMOTIV_PLUGIN_SECRET_KEY=
URMOTIV_EMAIL_LOGIN_ENABLED=
URMOTIV_EMAIL_REGISTRATION_ENABLED=
# 正式环境留空，从「管理 → 常规设置」读取通用 SMTP；test 仅供自动化测试使用。
URMOTIV_EMAIL_DELIVERY_MODE=
URMOTIV_EMAIL_VERIFICATION_WEB_URL=
URMOTIV_USTC_OAUTH_ENABLED=
URMOTIV_USTC_OAUTH_AUTHORIZE_URL=
URMOTIV_USTC_OAUTH_TOKEN_URL=
URMOTIV_USTC_OAUTH_PROFILE_URL=
URMOTIV_USTC_OAUTH_REDIRECT_URI=
URMOTIV_USTC_OAUTH_CLIENT_ID=
# 只写入服务器私有环境文件；接口、日志和审计均不得返回明文。
URMOTIV_USTC_OAUTH_CLIENT_SECRET=
# 独立的 32 字节随机值 Base64URL，不能与插件或经典 CAS 状态密钥复用。
URMOTIV_USTC_OAUTH_STATE_SECRET=
URMOTIV_USTC_OAUTH_SCOPE=
URMOTIV_CAS_ENABLED=
URMOTIV_CAS_LOGIN_URL=
URMOTIV_CAS_VALIDATE_URL=
URMOTIV_CAS_CALLBACK_URL=
URMOTIV_CAS_SUBJECT_ATTRIBUTE=
URMOTIV_CAS_EMAIL_ATTRIBUTE=
URMOTIV_CAS_NICKNAME_ATTRIBUTE=
URMOTIV_CAS_STATE_SECRET=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 可选完整备份：连接仍需在「管理 → 备份与恢复」验证保存并设置独立加密密码。
# WebDAV 数据保存到此地址下的 urmotiv/，不要填真实值后提交 Git。
WEBDAV_ADDR=
WEBDAV_USER=
WEBDAV_PASS=
# 非 Docker 启动时，填写持久化私有目录后才启用备份管理接口。
URMOTIV_BACKUP_DIR=
