FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/jobs/package.json packages/jobs/package.json
COPY packages/plugin-sdk/package.json packages/plugin-sdk/package.json
COPY packages/problem-package/package.json packages/problem-package/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY plugins/anklang/package.json plugins/anklang/package.json
COPY plugins/fermata-control/package.json plugins/fermata-control/package.json
COPY plugins/hydro-format/package.json plugins/hydro-format/package.json
COPY plugins/fps-format/package.json plugins/fps-format/package.json
COPY plugins/review-default/package.json plugins/review-default/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS runtime
COPY . .
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@urmotiv/api", "start"]
