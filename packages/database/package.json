{
  "name": "@urmotiv/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migration:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@urmotiv/contracts": "workspace:*",
    "drizzle-orm": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
