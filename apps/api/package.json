{
  "name": "@urmotiv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "bootstrap-admin": "tsx src/admin-bootstrap-cli.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:phase2-postgres:acceptance": "node scripts/phase2-acceptance.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@urmotiv/auth": "workspace:*",
    "@urmotiv/contracts": "workspace:*",
    "@urmotiv/database": "workspace:*",
    "@urmotiv/jobs": "workspace:*",
    "@urmotiv/plugin-anklang": "workspace:*",
    "@urmotiv/plugin-fermata-control": "workspace:*",
    "@urmotiv/plugin-hydro-format": "workspace:*",
    "@urmotiv/plugin-review-default": "workspace:*",
    "@urmotiv/plugin-sdk": "workspace:*",
    "@urmotiv/problem-package": "workspace:*",
    "@urmotiv/storage": "workspace:*",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "undici": "7.29.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
