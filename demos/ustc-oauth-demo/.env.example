# USTC OAuth2 demo environment template.
# Copy to a PRIVATE file on the server (e.g. /home/ubuntu/codex-urmotiv/Urmotiv/private/ustc-oauth-demo/demo.env), chmod 600,
# fill real values after institutional registration, then run: USTC_DEMO_ENV_FILE=/that/file sh run.sh
# The server REJECTS placeholder-like or weak secrets and REJECTS any redirect URI that is not HTTPS on *.ustc.edu.cn.
# Never commit this file with real values.

USTC_DEMO_HOST=127.0.0.1
USTC_DEMO_PORT=9797

# Issued by USTC 网络信息中心 after the 统一身份认证接入申请 (see README).
USTC_DEMO_CLIENT_ID=change-me-after-registration
USTC_DEMO_CLIENT_SECRET=change-me-after-registration

# Your own local HMAC/session secret (>= 32 random chars/hex). Refuse weak values.
USTC_DEMO_SESSION_SECRET=change-me-32-random-hex

# MUST match exactly what the institutional admin whitelisted.
USTC_DEMO_REDIRECT_URI=https://your-site.ustc.edu.cn/api/v1/auth/ustc/callback

# Path the server serves the OAuth callback at. In live mode this is IGNORED
# unless it EXACTLY equals the path of USTC_DEMO_REDIRECT_URI — the registered
# URI wins, so the callback is never served at an unregistered path.
USTC_DEMO_CALLBACK_PATH=/api/v1/auth/ustc/callback

# Official endpoints (already verified; only override for offline testing).
USTC_DEMO_AUTHORIZE_URL=https://id.ustc.edu.cn/cas/oauth2.0/authorize
USTC_DEMO_TOKEN_URL=https://id.ustc.edu.cn/cas/oauth2.0/accessToken
USTC_DEMO_PROFILE_URL=https://id.ustc.edu.cn/cas/oauth2.0/profile
USTC_DEMO_LOGOUT_URL=https://id.ustc.edu.cn/cas/logout

# Optional space-separated scope; the IdP normally releases per-app configured attributes instead.
USTC_DEMO_SCOPE=

USTC_DEMO_HTTP_TIMEOUT_MS=10000
USTC_DEMO_STATE_TTL_MS=600000

# Owner-only directory OUTSIDE this worktree where real account records are stored (0600 files, 0700 dir).
USTC_DEMO_DATA_DIR=/home/ubuntu/codex-urmotiv/Urmotiv/private/ustc-oauth-demo