# 复制到服务器的私有路径后填写；不要提交生成后的文件。
POSTGRES_USER=
# PostgreSQL 密码会进入 DATABASE_URL；请只使用字母、数字、连字符或下划线。
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=
# 32 字节随机值的 Base64URL 编码，用于加密保存插件令牌。
URMOTIV_PLUGIN_SECRET_KEY=
URMOTIV_WEB_ORIGIN=
# 仅在确认完整代理链后填写，必须是逗号分隔的精确 IPv4/IPv6 CIDR；留空最安全。
URMOTIV_TRUSTED_PROXY_CIDRS=

# 以下字段通常可以保留默认值。
URMOTIV_HTTP_PORT=8080
S3_REGION=us-east-1
JOB_REDIS_PREFIX=urmotiv:jobs
URMOTIV_EMAIL_LOGIN_ENABLED=true
URMOTIV_EMAIL_REGISTRATION_ENABLED=false
# 只接受 true 或 false。false 时不会读取下面的 CAS 配置。
URMOTIV_CAS_ENABLED=false
# 当前认证契约只有登录、票据校验和本站回调三个地址；没有 base/logout 配置。
# 正式环境启用 CAS 时，三个地址都必须是 HTTPS，且以下必填项不能留空；回调必须精确为
# URMOTIV_WEB_ORIGIN 加 /api/v1/auth/cas/callback，不能改到其他来源、路径或附带查询参数。
URMOTIV_CAS_LOGIN_URL=
URMOTIV_CAS_VALIDATE_URL=
URMOTIV_CAS_CALLBACK_URL=
# 稳定身份字段（先用占位并在真实联调时确认；缺失会在登录时明确报错）
URMOTIV_CAS_SUBJECT_ATTRIBUTE=cas:user
URMOTIV_CAS_EMAIL_ATTRIBUTE=
URMOTIV_CAS_NICKNAME_ATTRIBUTE=
# CAS 属性里包含学号的字段名，逗号分隔（例如 cas:studentId,cas:employeeNumber）。
# 登录时写入用户标识表，供历史题目按学号匹配预创建账号；留空则不采集。
URMOTIV_CAS_STUDENT_ID_ATTRIBUTES=
# 恰好 32 字节随机值的无填充 Base64URL 编码，用于登录状态签名；不要与其他密钥复用。
URMOTIV_CAS_STATE_SECRET=

# Fermata（AI 审核实验服务，见 compose.yaml）。它默认不随 `docker compose up` 启动，
# 需要用的时候把 COMPOSE_PROFILES 设为 fermata；不需要时留空即可。
# Fermata 的服务地址和超时改在管理后台的“Fermata 审核服务管理”插件设置里配置，
# 不是这里的环境变量；FERMATA_BASE_URL 只是部署时用来提醒该填什么值的备忘。
# Fermata 自己的模型 / 服务凭据放在单独的私有环境文件里（compose.yaml 中的
# fermata 服务通过 env_file 引用），不要写进这个文件。
COMPOSE_PROFILES=
FERMATA_BASE_URL=
